{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiber.dev/research/v1/operator-direction-record.schema.json",
  "title": "TIBER Research v1 operator direction record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authority_class",
    "decision_ref",
    "operator",
    "candidate_run_id",
    "operator_direction",
    "quote_digest",
    "quote_digest_mode",
    "recorded_at",
    "approved_artifact_refs",
    "scope",
    "exclusions",
    "terminal_outcomes"
  ],
  "properties": {
    "schema_version": {
      "const": "research-operator-direction-record/v1"
    },
    "authority_class": {
      "enum": [
        "stage1_preflight_only",
        "activate_run"
      ]
    },
    "decision_ref": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
    },
    "operator": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
    },
    "candidate_run_id": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
    },
    "operator_direction": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
    },
    "quote_digest": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/digest"
    },
    "quote_digest_mode": {
      "const": "tiber-raw-sha256-v1"
    },
    "recorded_at": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/timestamp"
    },
    "approved_artifact_refs": {
      "type": "array",
      "items": {
        "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/artifactDigest"
      }
    },
    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "exclusions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
      },
      "uniqueItems": true
    },
    "terminal_outcomes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
      },
      "uniqueItems": true
    }
  }
}
