{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiber.dev/research/v1/trusted-usage-receipt.schema.json",
  "title": "TIBER Research v1 trusted usage receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "receipt_id",
    "candidate_run_id",
    "attempt_id",
    "role",
    "actor_session_ref",
    "invocation_id",
    "provider",
    "model",
    "usage_started_at",
    "usage_ended_at",
    "observed_at",
    "provider_native_usage",
    "normalized_cost",
    "observer",
    "observation_method",
    "trust_boundary",
    "rate_card_digest",
    "cost_policy_ref",
    "previous_receipt_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "research-trusted-usage-receipt/v1"
    },
    "receipt_id": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
    },
    "candidate_run_id": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
    },
    "attempt_id": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
    },
    "role": {
      "enum": [
        "executor",
        "reviewer"
      ]
    },
    "actor_session_ref": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
    },
    "invocation_id": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
    },
    "provider": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
    },
    "model": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
    },
    "usage_started_at": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/timestamp"
    },
    "usage_ended_at": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/timestamp"
    },
    "observed_at": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/timestamp"
    },
    "provider_native_usage": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unit",
          "quantity"
        ],
        "properties": {
          "unit": {
            "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
          },
          "quantity": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "normalized_cost": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "unit",
        "amount"
      ],
      "properties": {
        "unit": {
          "enum": [
            "usd_micro",
            "tiber_actor_session_v1"
          ]
        },
        "amount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "observer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observer_id",
        "role",
        "trust_basis"
      ],
      "properties": {
        "observer_id": {
          "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
        },
        "role": {
          "enum": [
            "trusted_runner",
            "trusted_connector",
            "operator"
          ]
        },
        "trust_basis": {
          "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/nonEmptyString"
        }
      }
    },
    "trust_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "boundary_id",
        "boundary_type",
        "policy_ref"
      ],
      "properties": {
        "boundary_id": {
          "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/safeId"
        },
        "boundary_type": {
          "enum": [
            "provider_usage_api",
            "connector_receipt",
            "runner_observation",
            "operator_attestation"
          ]
        },
        "policy_ref": {
          "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/artifactDigest"
        }
      }
    },
    "rate_card_digest": {
      "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/digest"
    },
    "cost_policy_ref": {
      "allOf": [
        {
          "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/artifactDigest"
        },
        {
          "type": "object",
          "properties": {
            "artifact_type": {
              "const": "cost_policy"
            }
          }
        }
      ]
    },
    "previous_receipt_digest": {
      "oneOf": [
        {
          "$ref": "https://schemas.tiber.dev/research/v0/common.schema.json#/$defs/digest"
        },
        {
          "type": "null"
        }
      ]
    },
    "observation_method": {
      "const": "provider_usage_observation"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "normalized_cost": {
            "type": "object",
            "properties": {
              "unit": {
                "const": "tiber_actor_session_v1"
              }
            },
            "required": [
              "unit"
            ]
          }
        },
        "required": [
          "normalized_cost"
        ]
      },
      "then": {
        "properties": {
          "normalized_cost": {
            "type": "object",
            "properties": {
              "amount": {
                "const": 1
              }
            }
          }
        }
      }
    }
  ]
}
