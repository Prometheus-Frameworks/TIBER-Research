{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiber.dev/research/v0/inputs.schema.json",
  "title": "TIBER Research v0 frozen input manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic_fixture",
    "run_id",
    "frozen_at",
    "cutoff_at",
    "job_ref",
    "research_context",
    "subjects",
    "comparisons",
    "artifacts",
    "sources",
    "market_snapshots",
    "blocked_inputs"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "research-inputs/v0",
        "research-inputs/v0.1"
      ]
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "frozen_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "cutoff_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "job_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_version",
        "path",
        "digest",
        "digest_mode"
      ],
      "properties": {
        "job_id": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "job_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "digest_mode": {
          "const": "tiber-raw-sha256-v1"
        }
      }
    },
    "research_context": {
      "$ref": "common.schema.json#/$defs/researchContext"
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/subject"
      }
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "common.schema.json#/$defs/subject"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_id",
          "repository",
          "commit",
          "path",
          "blob_digest",
          "artifact_digest",
          "admissibility",
          "freshness"
        ],
        "properties": {
          "artifact_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "repository": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "commit": {
            "type": "string",
            "pattern": "^[a-f0-9]{40,64}$"
          },
          "path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "blob_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "artifact_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "admissibility": {
            "$ref": "common.schema.json#/$defs/admissibilityState"
          },
          "freshness": {
            "$ref": "common.schema.json#/$defs/freshnessState"
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_object_id",
          "metadata_path",
          "metadata_digest",
          "content_path",
          "content_digest",
          "retention_mode",
          "replayability",
          "admissibility",
          "promotable"
        ],
        "properties": {
          "source_object_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "metadata_path": {
            "$ref": "common.schema.json#/$defs/relativePath"
          },
          "metadata_digest": {
            "$ref": "common.schema.json#/$defs/digest"
          },
          "content_path": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/relativePath"
              },
              {
                "type": "null"
              }
            ]
          },
          "content_digest": {
            "oneOf": [
              {
                "$ref": "common.schema.json#/$defs/digest"
              },
              {
                "type": "null"
              }
            ]
          },
          "retention_mode": {
            "$ref": "common.schema.json#/$defs/retentionMode"
          },
          "replayability": {
            "$ref": "common.schema.json#/$defs/replayability"
          },
          "admissibility": {
            "$ref": "common.schema.json#/$defs/admissibilityState"
          },
          "promotable": {
            "type": "boolean"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "replayability": {
                  "const": "full_replay"
                }
              },
              "required": [
                "replayability"
              ]
            },
            "then": {
              "properties": {
                "content_path": {
                  "$ref": "common.schema.json#/$defs/relativePath"
                },
                "content_digest": {
                  "$ref": "common.schema.json#/$defs/digest"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "replayability": {
                  "const": "lineage_only"
                }
              },
              "required": [
                "replayability"
              ]
            },
            "then": {
              "properties": {
                "promotable": {
                  "const": false
                }
              }
            }
          }
        ]
      }
    },
    "market_snapshots": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "market_snapshot_id",
          "source_object_refs",
          "context_ref",
          "context",
          "observed_at",
          "window_start",
          "window_end",
          "aggregation_method",
          "sample_size",
          "known_bias",
          "freshness"
        ],
        "properties": {
          "market_snapshot_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "source_object_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "context_ref": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "context": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "observed_at": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "window_start": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "window_end": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "aggregation_method": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "sample_size": {
            "type": "integer",
            "minimum": 1
          },
          "known_bias": {
            "$ref": "common.schema.json#/$defs/stringList"
          },
          "freshness": {
            "$ref": "common.schema.json#/$defs/freshnessState"
          }
        }
      }
    },
    "blocked_inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "input_id",
          "question_refs",
          "reason",
          "status"
        ],
        "properties": {
          "input_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "question_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "reason": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "status": {
            "enum": [
              "unavailable",
              "excluded",
              "inadmissible",
              "identity_unresolved",
              "cutoff_failure"
            ]
          },
          "owner_repository": {
            "$ref": "common.schema.json#/$defs/ownerRepository"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "schema_version": {
            "const": "research-inputs/v0"
          }
        },
        "required": [
          "schema_version"
        ]
      },
      "then": {
        "properties": {
          "blocked_inputs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "owner_repository": false
              }
            }
          }
        }
      }
    }
  ]
}
