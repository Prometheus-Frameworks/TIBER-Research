{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiber.dev/research/v0/authority-decision.schema.json",
  "title": "TIBER Research v0 operator authority decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic_fixture",
    "decision_ref",
    "decision_type",
    "run_id",
    "job_ref",
    "inputs_ref",
    "cutoff_at",
    "capabilities",
    "budget",
    "authority_ceiling",
    "permitted_branch",
    "permitted_path",
    "approved_at",
    "approved_by",
    "scope",
    "exclusions"
  ],
  "properties": {
    "schema_version": {
      "const": "research-authority-decision/v0"
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "decision_ref": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "decision_type": {
      "const": "activate_run"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "job_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_id",
        "job_version",
        "path",
        "digest",
        "digest_mode"
      ],
      "properties": {
        "job_id": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "job_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "digest_mode": {
          "const": "tiber-raw-sha256-v1"
        }
      }
    },
    "inputs_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "digest",
        "digest_mode"
      ],
      "properties": {
        "path": {
          "$ref": "common.schema.json#/$defs/relativePath"
        },
        "digest": {
          "$ref": "common.schema.json#/$defs/digest"
        },
        "digest_mode": {
          "const": "tiber-canonical-json-v1"
        }
      }
    },
    "cutoff_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "capabilities": {
      "$ref": "common.schema.json#/$defs/capabilities"
    },
    "budget": {
      "$ref": "common.schema.json#/$defs/budget"
    },
    "authority_ceiling": {
      "const": "research_custody_only"
    },
    "permitted_branch": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
      "maxLength": 255
    },
    "permitted_path": {
      "$ref": "common.schema.json#/$defs/relativePath"
    },
    "approved_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "approved_by": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "scope": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "exclusions": {
      "$ref": "common.schema.json#/$defs/stringList"
    }
  }
}
