{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiber.dev/research/v0/packet.schema.json",
  "title": "TIBER Research v0 structured packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic_fixture",
    "job_id",
    "job_version",
    "run_id",
    "attempt_id",
    "output_class",
    "title",
    "generated_at",
    "process_terminal",
    "completion",
    "authority_state",
    "downstream_authority",
    "questions",
    "claims",
    "negative_findings",
    "unresolved",
    "followups",
    "limitations",
    "reportability"
  ],
  "properties": {
    "schema_version": {
      "const": "research-packet/v0"
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "job_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "run_id": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "attempt_id": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "output_class": {
      "enum": [
        "evidence_inventory",
        "hypothesis_comparison",
        "calculation_record",
        "methodology_note",
        "structured_research_packet",
        "negative_result",
        "blocked_state",
        "synthetic_conformance_fixture"
      ]
    },
    "title": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "generated_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "process_terminal": {
      "enum": [
        "completed",
        "blocked",
        "cancelled",
        "budget_exhausted",
        "protocol_violation"
      ]
    },
    "completion": {
      "enum": [
        "answered",
        "inconclusive",
        "blocked"
      ]
    },
    "authority_state": {
      "const": "unpromoted"
    },
    "downstream_authority": {
      "const": "none"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "prompt",
          "completion",
          "assessment",
          "blocker_reason",
          "claim_refs",
          "limitations"
        ],
        "properties": {
          "question_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "prompt": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "completion": {
            "enum": [
              "answered",
              "inconclusive",
              "blocked"
            ]
          },
          "assessment": {
            "enum": [
              "supported",
              "partly_supported",
              "weakened",
              "contradicted",
              "insufficient"
            ]
          },
          "blocker_reason": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "missing_evidence",
              "inadmissible_source",
              "identity_unresolved",
              "cutoff_failure",
              "comparison_coverage_missing",
              null
            ]
          },
          "claim_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "limitations": {
            "$ref": "common.schema.json#/$defs/stringList"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "negative_findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "statement",
          "question_refs",
          "subject_refs",
          "hypothesis_refs",
          "evidence_refs",
          "challenge_refs",
          "limitations"
        ],
        "properties": {
          "finding_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "statement": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "question_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "subject_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "hypothesis_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/safeId"
            },
            "uniqueItems": true
          },
          "evidence_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "challenge_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "common.schema.json#/$defs/safeId"
            },
            "uniqueItems": true
          },
          "limitations": {
            "$ref": "common.schema.json#/$defs/stringList"
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "unresolved_id",
          "kind",
          "statement",
          "blocked_input_refs",
          "related_claim_refs",
          "related_question_refs"
        ],
        "properties": {
          "unresolved_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "kind": {
            "enum": [
              "contradiction",
              "missing_evidence",
              "blocked_input"
            ]
          },
          "statement": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "blocked_input_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "related_claim_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          },
          "related_question_refs": {
            "$ref": "common.schema.json#/$defs/idList"
          }
        }
      }
    },
    "followups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "followup_id",
          "question",
          "rationale",
          "requires_new_run"
        ],
        "properties": {
          "followup_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "question": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "rationale": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          },
          "requires_new_run": {
            "type": "boolean"
          }
        }
      }
    },
    "limitations": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "reportability": {
      "enum": [
        "public_safe",
        "internal",
        "non_promotable",
        "later_review_only"
      ]
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "question_ref",
        "subject_ref",
        "claim_type",
        "epistemic_class",
        "assessment",
        "statement",
        "scope",
        "baseline_ref",
        "baseline_position",
        "comparison_refs",
        "hypothesis_refs",
        "evidence_refs",
        "calculation_refs",
        "counterevidence_refs",
        "challenge_refs",
        "missing_evidence_refs",
        "proposed_disposition",
        "limitations",
        "confidence",
        "freshness",
        "market_inefficiency_claim",
        "market_snapshot_ref"
      ],
      "properties": {
        "claim_id": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "question_ref": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "subject_ref": {
          "$ref": "common.schema.json#/$defs/safeId"
        },
        "claim_type": {
          "enum": [
            "synthetic_threshold_finding",
            "evidence_assessment",
            "opportunity_assessment",
            "market_inefficiency",
            "negative_finding",
            "methodological"
          ]
        },
        "epistemic_class": {
          "$ref": "common.schema.json#/$defs/epistemicClass"
        },
        "assessment": {
          "enum": [
            "supported",
            "partly_supported",
            "weakened",
            "contradicted",
            "insufficient"
          ]
        },
        "statement": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "population",
            "context_ref",
            "context",
            "time_horizon",
            "cutoff_at"
          ],
          "properties": {
            "population": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "context": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "context_ref": {
              "$ref": "common.schema.json#/$defs/safeId"
            },
            "time_horizon": {
              "$ref": "common.schema.json#/$defs/nonEmptyString"
            },
            "cutoff_at": {
              "$ref": "common.schema.json#/$defs/timestamp"
            }
          }
        },
        "baseline_ref": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/safeId"
            },
            {
              "type": "null"
            }
          ]
        },
        "baseline_position": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "comparison_refs": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "hypothesis_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "uniqueItems": true
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "uniqueItems": true
        },
        "calculation_refs": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "uniqueItems": true
        },
        "counterevidence_refs": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "challenge_refs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "uniqueItems": true
        },
        "missing_evidence_refs": {
          "$ref": "common.schema.json#/$defs/idList"
        },
        "proposed_disposition": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            "upstream",
            "downstream",
            "unchanged",
            "insufficient_evidence",
            null
          ]
        },
        "limitations": {
          "$ref": "common.schema.json#/$defs/stringList"
        },
        "confidence": {
          "$ref": "common.schema.json#/$defs/confidence"
        },
        "freshness": {
          "$ref": "common.schema.json#/$defs/freshness"
        },
        "market_inefficiency_claim": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 4096
        },
        "market_snapshot_ref": {
          "oneOf": [
            {
              "$ref": "common.schema.json#/$defs/safeId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "claim_type": {
                "const": "market_inefficiency"
              }
            },
            "required": [
              "claim_type"
            ]
          },
          "then": {
            "properties": {
              "market_inefficiency_claim": {
                "type": "string",
                "minLength": 1
              },
              "market_snapshot_ref": {
                "$ref": "common.schema.json#/$defs/safeId"
              }
            }
          },
          "else": {
            "properties": {
              "market_inefficiency_claim": {
                "type": "null"
              },
              "market_snapshot_ref": {
                "type": "null"
              }
            }
          }
        }
      ]
    }
  }
}
