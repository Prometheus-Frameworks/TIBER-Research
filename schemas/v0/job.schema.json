{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.tiber.dev/research/v0/job.schema.json",
  "title": "TIBER Research v0 job",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "synthetic_fixture",
    "job_id",
    "job_version",
    "purpose",
    "questions",
    "mode",
    "output_class",
    "subjects",
    "comparison_population",
    "baseline_ref",
    "cutoff_at",
    "time_horizon",
    "source_envelope",
    "research_context",
    "context_policy",
    "capabilities",
    "authority",
    "actor_roles",
    "budgets",
    "gates",
    "stop_conditions",
    "cancellation_conditions",
    "blocked_conditions",
    "inconclusive_conditions",
    "escalation_conditions",
    "terminal_states",
    "reportability"
  ],
  "properties": {
    "schema_version": {
      "const": "research-job/v0"
    },
    "synthetic_fixture": {
      "type": "boolean"
    },
    "job_id": {
      "$ref": "common.schema.json#/$defs/safeId"
    },
    "job_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "purpose": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "question_id",
          "prompt"
        ],
        "properties": {
          "question_id": {
            "$ref": "common.schema.json#/$defs/safeId"
          },
          "prompt": {
            "$ref": "common.schema.json#/$defs/nonEmptyString"
          }
        }
      }
    },
    "mode": {
      "enum": [
        "synthetic_conformance",
        "bounded_domain_research"
      ]
    },
    "output_class": {
      "enum": [
        "evidence_inventory",
        "hypothesis_comparison",
        "calculation_record",
        "methodology_note",
        "structured_research_packet",
        "negative_result",
        "blocked_state",
        "synthetic_conformance_fixture"
      ]
    },
    "subjects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "common.schema.json#/$defs/subject"
      }
    },
    "comparison_population": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "members"
      ],
      "properties": {
        "mode": {
          "const": "closed"
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "common.schema.json#/$defs/subject"
          }
        }
      }
    },
    "baseline_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "input_id",
            "digest"
          ],
          "properties": {
            "input_id": {
              "$ref": "common.schema.json#/$defs/safeId"
            },
            "digest": {
              "$ref": "common.schema.json#/$defs/digest"
            }
          }
        }
      ]
    },
    "cutoff_at": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "time_horizon": {
      "$ref": "common.schema.json#/$defs/nonEmptyString"
    },
    "source_envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "families",
        "evidence_classes",
        "default_retention_mode",
        "required_replayability"
      ],
      "properties": {
        "families": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_family_id",
              "intended_use",
              "acquisition_methods",
              "retention_modes",
              "reportability",
              "rights_disposition_ref"
            ],
            "properties": {
              "source_family_id": {
                "$ref": "common.schema.json#/$defs/safeId"
              },
              "intended_use": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              },
              "acquisition_methods": {
                "$ref": "common.schema.json#/$defs/idList"
              },
              "retention_modes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "$ref": "common.schema.json#/$defs/retentionMode"
                },
                "uniqueItems": true
              },
              "reportability": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "public_safe",
                    "internal",
                    "non_promotable",
                    "later_review_only"
                  ]
                },
                "uniqueItems": true
              },
              "rights_disposition_ref": {
                "$ref": "common.schema.json#/$defs/nonEmptyString"
              }
            }
          }
        },
        "evidence_classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "governed_tiber_artifact",
              "operator_provided_observation",
              "admitted_external_source",
              "deterministic_calculation",
              "synthetic_fixture_observation"
            ]
          },
          "uniqueItems": true
        },
        "default_retention_mode": {
          "$ref": "common.schema.json#/$defs/retentionMode"
        },
        "required_replayability": {
          "$ref": "common.schema.json#/$defs/replayability"
        }
      }
    },
    "research_context": {
      "$ref": "common.schema.json#/$defs/researchContext"
    },
    "context_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_context_classes",
        "prohibited_context_classes",
        "privacy_ceiling"
      ],
      "properties": {
        "allowed_context_classes": {
          "type": "array",
          "items": {
            "enum": [
              "stable_tiber_context",
              "pinned_tiber_artifact",
              "pilot_baseline",
              "admitted_public_evidence",
              "run_scoped_retrieved_material",
              "synthetic_fixture"
            ]
          },
          "uniqueItems": true
        },
        "prohibited_context_classes": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "enum": [
              "private_user_context",
              "hidden_reasoning",
              "provider_memory"
            ]
          },
          "uniqueItems": true
        },
        "privacy_ceiling": {
          "const": "public"
        }
      }
    },
    "capabilities": {
      "$ref": "common.schema.json#/$defs/capabilities"
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ceiling",
        "prohibited_actions",
        "human_decision_owner",
        "amendment_owner",
        "consumer_authority"
      ],
      "properties": {
        "ceiling": {
          "const": "research_custody_only"
        },
        "prohibited_actions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "source_acquisition",
              "modify_source_repository",
              "modify_ops",
              "modify_harness",
              "modify_strategy",
              "modify_forecast",
              "modify_product",
              "promotion",
              "publication",
              "scheduling",
              "private_context_access",
              "live_research"
            ]
          },
          "uniqueItems": true
        },
        "human_decision_owner": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "amendment_owner": {
          "$ref": "common.schema.json#/$defs/nonEmptyString"
        },
        "consumer_authority": {
          "const": "none"
        }
      }
    },
    "actor_roles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "executor",
        "reviewer"
      ],
      "properties": {
        "executor": {
          "const": "single_writer"
        },
        "reviewer": {
          "const": "fresh_context_read_only"
        }
      }
    },
    "budgets": {
      "$ref": "common.schema.json#/$defs/budget"
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "checkpoint_required",
        "cold_resume_required",
        "self_challenge_required",
        "independent_review_required",
        "single_writer_required"
      ],
      "properties": {
        "checkpoint_required": {
          "const": true
        },
        "cold_resume_required": {
          "const": true
        },
        "self_challenge_required": {
          "const": true
        },
        "independent_review_required": {
          "const": true
        },
        "single_writer_required": {
          "const": true,
          "description": "Require exclusive append authority. A replacement executor session may take over only immediately after a checkpoint."
        }
      }
    },
    "stop_conditions": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "cancellation_conditions": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "blocked_conditions": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "inconclusive_conditions": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "escalation_conditions": {
      "$ref": "common.schema.json#/$defs/stringList"
    },
    "terminal_states": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process",
        "completion",
        "review"
      ],
      "properties": {
        "process": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "completed",
              "blocked",
              "cancelled",
              "budget_exhausted",
              "protocol_violation"
            ]
          },
          "uniqueItems": true
        },
        "completion": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "answered",
              "inconclusive",
              "blocked"
            ]
          },
          "uniqueItems": true
        },
        "review": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "pass",
              "rework_required",
              "reject",
              "blocked",
              "not_reached"
            ]
          },
          "uniqueItems": true
        }
      }
    },
    "reportability": {
      "enum": [
        "public_safe",
        "internal",
        "non_promotable",
        "later_review_only"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "synthetic_fixture": {
            "const": true
          }
        },
        "required": [
          "synthetic_fixture"
        ]
      },
      "then": {
        "properties": {
          "mode": {
            "const": "synthetic_conformance"
          },
          "output_class": {
            "const": "synthetic_conformance_fixture"
          }
        }
      }
    }
  ]
}
