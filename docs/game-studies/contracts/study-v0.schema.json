{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tiber.local/manual-game-study-v0.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format_version",
    "study_id",
    "artifact_class",
    "game",
    "origin",
    "owner",
    "plan",
    "records",
    "game_final",
    "evaluation_state",
    "questions",
    "closeout",
    "downstream",
    "assessment_cutoff"
  ],
  "properties": {
    "format_version": {
      "const": "tiber-game-study/v0"
    },
    "study_id": {
      "type": "string",
      "pattern": "^nfl-[0-9]{4}-(reg|post)-w[0-9]{2}-[a-z]{2,3}-[a-z]{2,3}$"
    },
    "artifact_class": {
      "const": "manual_research"
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "season",
        "phase",
        "week",
        "away",
        "home",
        "kickoff_at",
        "timezone",
        "schedule_source_url",
        "provider_game_id"
      ],
      "properties": {
        "season": {
          "type": "integer",
          "minimum": 1900,
          "maximum": 2200
        },
        "phase": {
          "enum": [
            "reg",
            "post"
          ]
        },
        "week": {
          "type": "integer",
          "minimum": 1,
          "maximum": 22
        },
        "away": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}$"
        },
        "home": {
          "type": "string",
          "pattern": "^[A-Z]{2,3}$"
        },
        "kickoff_at": {
          "type": "string",
          "format": "date-time"
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "schedule_source_url": {
          "type": "string",
          "format": "uri"
        },
        "provider_game_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issue_url",
        "pregame_cutoff",
        "baseline_record_ref",
        "capture_limitations"
      ],
      "properties": {
        "issue_url": {
          "type": "string",
          "format": "uri"
        },
        "pregame_cutoff": {
          "type": "string",
          "format": "date-time"
        },
        "baseline_record_ref": {
          "type": "string",
          "minLength": 1
        },
        "capture_limitations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "owner": {
      "type": "string",
      "minLength": 1
    },
    "plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_endpoint",
        "first_review_at",
        "evidence_deadline",
        "working_branch",
        "scope",
        "stop_rule"
      ],
      "properties": {
        "observation_endpoint": {
          "type": "string",
          "minLength": 1
        },
        "first_review_at": {
          "type": "string",
          "format": "date-time"
        },
        "evidence_deadline": {
          "type": "string",
          "format": "date-time"
        },
        "working_branch": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "stop_rule": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "source_url",
          "captured_at",
          "path",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "pregame",
              "amendment",
              "postgame_evidence",
              "closeout"
            ]
          },
          "source_url": {
            "type": "string",
            "format": "uri"
          },
          "captured_at": {
            "type": "string",
            "format": "date-time"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "game_final": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "verified_at",
        "evidence_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "not_checked",
            "not_final",
            "final"
          ]
        },
        "verified_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "evaluation_state": {
      "enum": [
        "pending",
        "in_progress",
        "complete"
      ]
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "linked_ids",
          "baseline_refs",
          "assessment",
          "summary",
          "evidence_refs",
          "limitations",
          "next_action"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^Q[1-9][0-9]*[a-z]?$"
          },
          "question": {
            "type": "string",
            "minLength": 1
          },
          "linked_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "baseline_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "assessment": {
            "enum": [
              "pending",
              "supported",
              "challenged",
              "mixed",
              "unresolved"
            ]
          },
          "summary": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "next_action": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        }
      }
    },
    "closeout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "pr_url",
        "report_record_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "draft",
            "ready_for_review"
          ]
        },
        "pr_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "report_record_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "downstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "admission",
        "proposal_refs"
      ],
      "properties": {
        "admission": {
          "const": "not_admitted"
        },
        "proposal_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      }
    },
    "assessment_cutoff": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
