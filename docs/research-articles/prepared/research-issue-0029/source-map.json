      "block_mapping": [
        {
          "block": 1,
          "original_heading_or_lead": "## Architecture synthesis v0",
          "outer_section": 1,
          "sha256": "ffebccc7124b0f440109cabd5a3d6f4b3ed9de357e4b80dff18f79e13175dc2f"
        },
        {
          "block": 2,
          "original_heading_or_lead": "### A. The central distinction: reality, evidence, representation",
          "outer_section": 4,
          "sha256": "e006f6fa1da1d6813fbacbf55bb0e89e37764e08e55d8aff2c51f77d8bc2bcc9"
        },
        {
          "block": 3,
          "original_heading_or_lead": "### B. The picture: a web, observed through compressed lenses",
          "outer_section": 4,
          "sha256": "2f754c9962eb7c8155075317d9037596981526f94dbf9798a566eeb1380c5c4a"
        },
        {
          "block": 4,
          "original_heading_or_lead": "### C. Compression is question-specific, not a universal football score",
          "outer_section": 2,
          "sha256": "cf7cba086f274b8133612a030ba26719ae98ce101455b2c720a925705ed848fa"
        },
        {
          "block": 5,
          "original_heading_or_lead": "### D. The targets-only example: preserve the insight, tighten the analogy",
          "outer_section": 4,
          "sha256": "3de481c63fc379328ccaba7f115efe8c9c8eac63cbb9d9ab6849ddfcd6cbfff8"
        },
        {
          "block": 6,
          "original_heading_or_lead": "### E. “Lean for football”: a bounded verifier, not a truth oracle",
          "outer_section": 4,
          "sha256": "27b3025daf12ae98a40f6185a586fde9f67ed2dafa34d945106b3cabc9bae205"
        },
        {
          "block": 7,
          "original_heading_or_lead": "### F. Typed claims: no silent changes of epistemic status",
          "outer_section": 1,
          "sha256": "4ec056cd5e7f11754e427f8703be343c2baa23629f6b17732415f68bf85d5f75"
        },
        {
          "block": 8,
          "original_heading_or_lead": "### G. A checkable example and explicit negative cases",
          "outer_section": 4,
          "sha256": "1949195edf80e670bd6bb68dd46f1b4193843ed14dcedf16d82d5f7348cbb9d1"
        },
        {
          "block": 9,
          "original_heading_or_lead": "### H. Three evaluations, not one green badge",
          "outer_section": 4,
          "sha256": "94b987e819699eb9d5cf6af44d3744493a78a861ce375e157fe583bfe5fb23bd"
        },
        {
          "block": 10,
          "original_heading_or_lead": "### I. Reconcile with existing owners; do not create parallel architecture",
          "outer_section": 3,
          "sha256": "7c41c19c26d9aed9222cfd2e1cbd462ddafc53d9384c466b255c6603646a7ebe"
        },
        {
          "block": 11,
          "original_heading_or_lead": "### J. Durable research summaries, not just durable chats",
          "outer_section": 4,
          "sha256": "4df04fa9b55b4898c80432616c45e41153c06b4fddb0f7ba541a38f607a3d35a"
        },
        {
          "block": 12,
          "original_heading_or_lead": "### K. Smallest proposed next step and stop boundary",
          "outer_section": 7,
          "sha256": "dc9980ece76859399085c37d88e07ae0ac79d2434248ef7ad1a12a7cafdb36f6"
        }
      ],
