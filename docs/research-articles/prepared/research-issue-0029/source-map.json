      "block_mapping": [
        {
          "block": 1,
          "original_heading_or_lead": "> **October 7, 2026 update:** The original research framing is retained below. The appended **Architecture synthesis v0** records the later discussion of domain compression, the web-and-lenses visualization, and a bounded “Lean for football” verifier. This remains a research/design record, not an adopted contract or implementation authorization.",
          "outer_section": 1,
          "sha256": "a4e8233bb5b63ddaa9c4961cf00f386aa6f83da30f433d64042ef172407cce0b"
        },
        {
          "block": 2,
          "original_heading_or_lead": "## Motivation",
          "outer_section": 3,
          "sha256": "110c37605ab783f68add845e7f706b156cce1d03be6736bdbf122e48c83cc2e4"
        },
        {
          "block": 3,
          "original_heading_or_lead": "## Core model",
          "outer_section": 2,
          "sha256": "f6ea86d2ba7be83a791907e4dbee8f1369b0ebd4894f029d4bc6d078c2f178f4"
        },
        {
          "block": 4,
          "original_heading_or_lead": "## What this would mean for TIBER",
          "outer_section": 4,
          "sha256": "a93366686ba3d673f4bdde7a38df3a38cce5f0ba55b4c9757f7e0577517f326f"
        },
        {
          "block": 5,
          "original_heading_or_lead": "### 1. Interpretation before prediction",
          "outer_section": 5,
          "sha256": "0ed2401c006139542fe12830e89d59f73a3a357aa291a06fb4540602b797ca0f"
        },
        {
          "block": 6,
          "original_heading_or_lead": "### 2. Separate state claims from outcome claims",
          "outer_section": 4,
          "sha256": "c3c4a3e0e59e923cbad2793fc8454366d491f17de6a31d8a35407b7fa284acd8"
        },
        {
          "block": 7,
          "original_heading_or_lead": "### 3. Preserve uncertainty as information",
          "outer_section": 4,
          "sha256": "7d84a553390b20684b6029769881b27b1851995ecb794b819d11c17114b7b5d4"
        },
        {
          "block": 8,
          "original_heading_or_lead": "### 4. Evaluate probabilistically",
          "outer_section": 4,
          "sha256": "fbd6bb367ff2b89e9de444776c9c428c3f23ff2ea3d2fb6a88caa6a4ac9dce8a"
        },
        {
          "block": 9,
          "original_heading_or_lead": "### 5. Treat evidence as belief-changing",
          "outer_section": 4,
          "sha256": "3fd8e9d2208e641f5d4d71db150c9d9e818ebfe0498f42652b54d24d38f0a1ba"
        },
        {
          "block": 10,
          "original_heading_or_lead": "### 6. Preserve operator agency",
          "outer_section": 4,
          "sha256": "0bc166eca34e8770e83b6443fdd0d928e7f667328faa96367a401ff786f97dc2"
        },
        {
          "block": 11,
          "original_heading_or_lead": "## Why this matters",
          "outer_section": 4,
          "sha256": "116926b6499d19e244671023d6a6d8318ca0183d71e0b51c19f2e37bf0f419f2"
        },
        {
          "block": 12,
          "original_heading_or_lead": "## Proposed next work",
          "outer_section": 7,
          "sha256": "8db1adb11cdccdf4408d51ffd7b20cdf4c742ee5446593f1223338d39bc99c8f"
        },
        {
          "block": 13,
          "original_heading_or_lead": "## Guardrails",
          "outer_section": 7,
          "sha256": "506360bc7c2e8897b1cde3141f0ef9ce4e6e0d583c9ea405d2e4f19016f8d9d7"
        },
        {
          "block": 14,
          "original_heading_or_lead": "## Desired outcome",
          "outer_section": 5,
          "sha256": "e50010dfb15968c0371177eb6ce10369b8dc62702bcde3ae6e34c85336902a35"
        }
      ],
